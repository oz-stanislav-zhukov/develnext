<project name="#NAME#" basedir=".">
    <!-- set global properties for this build -->
    <property name="name" location="#NAME#"/>
    <property name="build" location="build"/>
    <property name="dist" location="build/dist"/>
    <property name="launch4j.dir" location="#LAUNCH4J_DIR#" />
    <property name="java.runtime.dir" location="#JAVA_RUNTIME_DIR#" />

    <taskdef name="launch4j" classname="net.sf.launch4j.ant.Launch4jTask">
        <classpath>
            <pathelement location="${launch4j.dir}/launch4j-purejava-patch.jar" />
            <pathelement location="${launch4j.dir}/launch4j.jar" />
            <fileset dir="${launch4j.dir}/lib" includes="*.jar" />
        </classpath>
    </taskdef>

    <target name="init">
        <mkdir dir="${build}"/>
    </target>

    <target name="jar" depends="init" description="generate the distribution">
        <mkdir dir="${dist}/lib"/>

        <jar destfile="${dist}/lib/dn-compiled-module.jar" encoding="UTF-8" level="7">
            #JAR_CONTENT#
        </jar>
    </target>

    <target name="dist" depends="jar" description="">
        #DIST_CONTENT#
    </target>

    <target name="onejar" depends="dist">
        <jar destfile="${dist}/#NAME#.jar" duplicate="preserve" level="7" encoding="UTF-8">
            <fileset dir="${dist}/gen" />
            <zipfileset src="${dist}/lib/dn-compiled-module.jar" />
            #ONE_JAR_CONTENT#

            <manifest>
                <attribute name="Main-Class" value="#MAIN_CLASS#" />
            </manifest>
        </jar>

        <delete dir="${dist}/gen" failonerror="false" />
        <delete failonerror="false">
            <fileset dir="${dist}/lib" includes="*.jar" />
        </delete>
    </target>

    <target name="clean" description="clean up">
        <delete dir="${build}"/>
    </target>

    <target name="copy-runtime">
        <mkdir dir="${dist}/runtime" />
        <copy todir="${dist}/runtime" >
            <fileset dir="${java.runtime.dir}" includes="**"/>
        </copy>
    </target>

    <target name="copy-jre" depends="copy-runtime" description="Legacy alias for copy-runtime" />

    <target name="launch4j">
        <launch4j>
            <config headerType="gui" outfile="${dist}/#NAME#.exe"
                    dontWrapJar="#L4J_DONT_WRAP_JAR#" jarPath="#L4J_JAR_FILE#" chdir="."
                    downloadUrl="http://java.com/download" icon="#L4J_ICON_FILE#">
                <classPath mainClass="org.develnext.jphp.ext.javafx.FXLauncher">
                    <cp>lib/*</cp>
                </classPath>
                <jre minVersion="25" path="#L4J_RUNTIME_PATH#" requiresJdk="false" requires64Bit="true">
                    <opt>--module-path="%EXEDIR%\lib\javafx"</opt>
                    <opt>--add-modules=javafx.base,javafx.graphics,javafx.controls,javafx.fxml,javafx.media,javafx.web,javafx.swing</opt>
                    <opt>--enable-native-access=ALL-UNNAMED,javafx.graphics,javafx.media,javafx.web</opt>
                    <opt>-Dfile.encoding=UTF-8</opt>
                </jre>
            </config>
        </launch4j>
        <delete file="#L4J_JAR_FILE#" failonerror="false" />
        <delete dir="${dist}/gen" failonerror="false" />
    </target>
</project>
